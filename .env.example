# ---------------------------------------------------------------------------
# KULT x ChainGPT Opportunity Intelligence POC - BACKEND
# Copy to .env and fill in CHAINGPT_API_KEY.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# --- Intelligence provider (spec 20) ---
# chaingpt = live showcase provider | demo = offline local fallback
INTELLIGENCE_PROVIDER=chaingpt

# --- ChainGPT (server-side secret, never exposed to browser - spec 18) ---
CHAINGPT_API_KEY=
# sdk = official @chaingpt/* SDKs (recommended for Node/TS - spec 11.4)
# rest = documented REST endpoints, useful for raw response smoke tests
CHAINGPT_TRANSPORT=sdk
CHAINGPT_BASE_URL=https://api.chaingpt.org
# REST transport only - the official SDK exposes no model parameter,
# so this is inert when CHAINGPT_TRANSPORT=sdk.
CHAINGPT_MODEL=general_assistant
# Applies the dedicated KULT AI Hub context configured against this key (spec 11.5)
# VERIFIED LIVE: with the AI Hub context unconfigured, ChainGPT answers
# "KULT is a cryptocurrency built on blockchain technology" - a wrong prior that
# would poison recommendations. Prompts already carry KULT context explicitly.
# Flip to true only after configuring the KULT context in the ChainGPT AI Hub,
# then confirm with `npm run smoke` (check 3).
CHAINGPT_USE_CUSTOM_CONTEXT=false

# --- Timeouts (spec 17) ---
NEWS_TIMEOUT_MS=20000
# ChainGPT's own gateway returns a 504 at ~80s, and the official SDK caps
# internally at 60s, so a larger value here buys nothing on the sdk transport.
REASONING_TIMEOUT_MS=75000

# --- Signal cache (spec 11.8) - seconds ---
# forceFreshSignals:true on a request skips the cache read (the frontend sends it
# on every Discover click, so the cache only serves repeat server-side reads).
SIGNAL_CACHE_TTL=600

# --- News retrieval ---
# Articles older than this are "stale": still usable, but flagged in the UI,
# down-weighted in confidence, and never presented as current.
NEWS_FRESHNESS_DAYS=14
# Optional ChainGPT category filter for the goal-driven evidence need.
# VERIFIED LIVE 2026-09-18: 2 = "Blockchain Gaming" (8 = NFT, 4 = DApps - not
# gaming/AI as previously assumed). Off by default: most gaming articles have no
# category at all, so filtering hides more than it finds.
NEWS_CATEGORY_IDS=

# --- Prompt budget ---
# VERIFIED LIVE: ChainGPT stops reading a question in full between ~5.1k and ~6k
# chars (canary test), and ~7.6k drew a gateway 504. Prompts are compacted to
# fit this before sending (see DETAIL_LEVELS in src/intelligence/prompts.ts).
PROMPT_CHAR_BUDGET=4600

# --- Credit accounting (metrics tab) ---
# ChainGPT does not report usage per call, so spend is ESTIMATED from these
# per-call rates. Set them from your ChainGPT billing page (1 credit = $0.01).
CHAINGPT_CREDITS_PER_CHAT=1
CHAINGPT_CREDITS_PER_CHAT_HISTORY=1
CHAINGPT_CREDITS_PER_NEWS=1

# --- Auth and abuse protection (audit A-1) ---
# off     - local development, no credentials
# api_key - clients send x-api-key matching one of API_KEYS (comma-separated).
#           A key in a browser bundle is public: this stops drive-by abuse only.
# privy   - clients send "Authorization: Bearer <Privy access token>". The DID
#           becomes the user; with AUTH_REQUIRE_AGENT_OWNERSHIP a user can only
#           spend credits on / write memory for their own Agent.
AUTH_MODE=off
API_KEYS=
PRIVY_APP_ID=
# Privy dashboard > Settings > Verification key (ES256 PEM). Use \n for newlines.
PRIVY_VERIFICATION_KEY=
AUTH_REQUIRE_AGENT_OWNERSHIP=true
# Required for POST /api/intelligence/reset (header x-admin-token). When unset,
# reset is allowed only outside NODE_ENV=production.
ADMIN_TOKEN=

# Rate limits. Credit-spending routes (scan, research, grow) are limited per
# client AND globally per window; every /api route has a per-minute flood cap.
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_SPEND_PER_CLIENT=20
RATE_LIMIT_SPEND_GLOBAL=200
RATE_LIMIT_API_PER_MINUTE=240
# Behind a load balancer, set to the number of proxy hops so req.ip (and the
# per-client limits) see the real client.
TRUST_PROXY=0

# --- KULT context source ---
# Points at the real KULT Creator Studio API (@kult/creator-backend).
# Blank by default (audit A-6): a copied localhost value made every request try an
# unreachable host first.
#   local:  http://localhost:3001/api
#   hosted: https://<your-kult-host>/api
# Leave blank to use the bundled fixtures, which are real KULT game packages run
# through the same mappers - so both paths exercise identical code.
#
# Only read-only endpoints are called: /games/:id, /games/list, /social/stats/:id,
# /social/profile/:id, /social/activity/user/:id, /social/points/:id.
# /social/creator-stats/:id is deliberately NOT used - it writes a 0G profile
# snapshot as a side effect of reading.
KULT_API_BASE=
# Bearer token. Without it, creator game lists fall back to filtering the public
# published list, since /games/list?creatorId= requires owning that identity.
KULT_AUTH_SECRET=

# --- Memory store ---
DATA_DIR=./data

# --- POC database (spec 20: memory adapter) ---
# The POC's OWN database. Same Atlas cluster is fine; the DATABASE must be
# separate from KULT's, because the POC writes knowledge/actions/outcomes and
# exposes a reset endpoint. src/db/mongo.ts refuses known production db names.
# Leave MONGODB_URI blank to fall back to the zero-infrastructure file store.
# Each record is its own document (poc_knowledge, poc_runs, ...). On first start
# the legacy single-document store (poc_state) is copied over once and left intact.
MONGODB_URI=
MONGODB_DB_NAME=poc
